# MongoDB connection string for Prisma
# MongoDB Atlas (Cloud) connection string:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/uddyogta?retryWrites=true&w=majority"
#
# Local MongoDB connection string:
# DATABASE_URL="mongodb://localhost:27017/uddyogta"

DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/uddyogta?retryWrites=true&w=majority"
